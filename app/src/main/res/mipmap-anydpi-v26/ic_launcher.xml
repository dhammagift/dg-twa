<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+), same setup as dict-app. Without it the launcher wraps the
     legacy square mipmap-*/ic_launcher.png on its own white plate, visible around the icon when it
     is tapped. Background = @color/ic_launcher_background (values/colors.xml) — change the icon's
     background there, one line; foreground = the octagon on transparent, inside the mask's safe
     zone; monochrome = themed icons (Android 13+). Legacy PNGs stay for Android 7 and older. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
