<!-- The "package" attribute is rewritten by the Gradle build with the value of applicationId.
     It is still required here, as it is used to derive paths, for instance when referring
     to an Activity by ".MyActivity" instead of the full name. If more Activities are added to the
     application, the package attribute will need to reflect the correct path in order to use
     the abbreviated format. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="gift.dhamma.pali">

    
        <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    

    

    

    

    <application
        android:name="Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        
       
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/assetStatements" />

        <!-- The searchable activity for a query that arrives without a component — this is the
             counterpart android.app.searchable (declared on LauncherActivity) needs to be reachable
             at all, and it is what "Search in apps" resolves for this package. -->
        <meta-data
            android:name="android.app.default_searchable"
            android:value="gift.dhamma.pali.LauncherActivity" />

        
            <meta-data
                android:name="web_manifest_url"
                android:value="@string/webManifestUrl" />
        

        <meta-data
            android:name="twa_generator"
            android:value="@string/generatorApp" />

        


        <activity android:name="LauncherActivity"
            android:alwaysRetainTaskState="true"
            android:label="@string/launcherName"
            android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launchUrl" />

<meta-data
    android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
    android:resource="@color/dark_primary" />

<meta-data
    android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
    android:resource="@color/background_color" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/navigationColor" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/navigationColorDark" />

            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/navigationDividerColor" />

            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR_DARK"
                android:resource="@color/navigationDividerColorDark" />

            <meta-data android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash"/>

            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/backgroundColor"/>

            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="@integer/splashScreenFadeOutDuration"/>

            <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="@string/providerAuthority"/>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="@string/fallbackType" />

            
                <meta-data
                    android:name="android.support.customtabs.trusted.METADATA_SHARE_TARGET"
                    android:resource="@string/shareTarget"/>
            

            

            <meta-data android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="@string/orientation"/>

            

            
                <intent-filter>
                    
                        <action android:name="android.intent.action.SEND" />
                    
                    <category android:name="android.intent.category.DEFAULT" />
                    
                        <data android:mimeType="text/plain" />
                    
                </intent-filter>
            

<intent-filter>
    <action android:name="android.intent.action.MAIN" />
    <category android:name="android.intent.category.LAUNCHER" />
</intent-filter>
<!-- BEGIN SHARING INTENT-FILTER -->
<intent-filter>
    <action android:name="android.intent.action.SEND" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:mimeType="text/plain" />
</intent-filter>
<!-- END SHARING INTENT-FILTER -->

<!-- BEGIN TEXT-SELECTION INTENT-FILTER -->
<!-- The same shortcut as "Share -> Dict.Dhamma.Gift", one chooser shorter: select a word in any
     app and the app sits in the text selection toolbar (or its overflow) next to Copy/Translate.
     The label Android prints is this activity's own (android:label above, i.e. launcherName).
     android:priority="1000": the platform appends these items in queryIntentActivities order,
     which for activities is RESOLVE_PRIORITY_SORTER — priority first, then system-before-user,
     and only then the package name alphabetically; at the default 0 the item sorted below every
     com.* app. text/* rather than text/plain: rich-text editors send text/html, and those are
     the apps where a text/plain filter never shows up. LauncherActivity turns the selected text
     into the site's ?q= search. -->
<intent-filter android:priority="1000">
    <action android:name="android.intent.action.PROCESS_TEXT" />
    <category android:name="android.intent.category.DEFAULT" />
    <data android:mimeType="text/*" />
</intent-filter>
<!-- END TEXT-SELECTION INTENT-FILTER -->

<!-- BEGIN SYSTEM-SEARCH INTENT-FILTER -->
<!-- Android's system search asks this app for words (res/xml/searchable.xml declares the
     provider and the "Search in apps" flag) and delivers a submitted query as ACTION_SEARCH.
     LauncherActivity turns that query into https://dict.dhamma.gift/?q=…, so the site's own
     lookup answers it — the same path a shared word and the tile take.
     The android.app.searchable meta-data is what binds the searchable description to THIS
     activity: without it the system has a provider and no activity to hand the query to. -->
<intent-filter>
    <action android:name="android.intent.action.SEARCH" />
    <category android:name="android.intent.category.DEFAULT" />
</intent-filter>
<meta-data
    android:name="android.app.searchable"
    android:resource="@xml/searchable" />
<!-- END SYSTEM-SEARCH INTENT-FILTER -->

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                    android:host="@string/hostName"
                
                />
            </intent-filter>

            

            
        </activity>

        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />

        <activity android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/providerAuthority"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- BEGIN SYSTEM-SEARCH PROVIDER -->
        <!-- Answers the system search with dictionary words (see DgDictSuggestProvider). exported
             is required — the search UI is another process — and the provider serves a public word
             list, so no permission guards it: it exposes no user data, only the words the site
             itself publishes. The authority is repeated in res/xml/searchable.xml; the two must
             match or suggestions silently never appear. -->
        <provider
            android:name=".DgDictSuggestProvider"
            android:authorities="gift.dhamma.pali.suggest"
            android:exported="true" />
        <!-- END SYSTEM-SEARCH PROVIDER -->

        <!-- BEGIN QUICK SETTINGS TILE -->
        <!-- The dictionary in the shade (DgDictTileService). exported="true" is required: the
             system's Quick Settings process binds this service, and without the flag the tile could
             never be added. BIND_QUICK_SETTINGS_TILE is a signature permission held by the platform,
             so only the system can bind it. The tile is invisible until the reader drags it into the
             panel — Android's rule for every app.
             The icon is the brand mark (drawable/ic_tile, the same traced glyph dg-app-full uses),
             not @mipmap/ic_launcher: a Quick Settings tile draws a single monochrome drawable, and
             an adaptive launcher icon shows up there as an empty plate.
             The label is the app's own name, not a second one: the tile sits under the app's name in
             the shade, so "Dictionary" above "Dict.Dhamma.Gift" was one label too many. -->
        <service
            android:name=".DgDictTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/launcherName"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- END QUICK SETTINGS TILE -->

        <service
            android:name=".DelegationService"
            android:enabled="@bool/enableNotification"
            android:exported="@bool/enableNotification">

            
                <meta-data
                    android:name="android.support.customtabs.trusted.SMALL_ICON"
                    android:resource="@drawable/ic_notification_icon" />
            

            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </service>

        
            <activity android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity" />
        

        
            
    </application>
</manifest>
